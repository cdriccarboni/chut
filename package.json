{
  "name": "chut",
  "productName": "Chut!",
  "version": "0.1.0",
  "description": "Débruiteur audio gratuit et 100 % local (DeepFilterNet), pour Mac, Windows et Linux.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "Cédric Carboni",
  "homepage": "https://github.com/cdriccarboni/chut",
  "repository": {
    "type": "git",
    "url": "https://github.com/cdriccarboni/chut.git"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "fetch-engine": "node scripts/fetch-engine.mjs",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node scripts/smoke.mjs",
    "icons": "electron scripts/render-icon.js && node scripts/make-icons.mjs",
    "dist:mac": "electron-builder --mac --arm64 --x64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never"
  },
  "build": {
    "appId": "io.github.cdriccarboni.chut",
    "productName": "Chut!",
    "artifactName": "Chut-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "engines/${os}-${arch}",
        "to": "engine"
      },
      {
        "from": "third_party",
        "to": "third_party"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Chut! ${version}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Chut-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Chut-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Audio",
      "maintainer": "Cédric Carboni <noreply@github.com>",
      "synopsis": "Débruiteur audio local"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
